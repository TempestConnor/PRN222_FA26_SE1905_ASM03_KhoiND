@page "/supply-items"
@inject ISupplyItemServiceKhoiND Service

<PageTitle>Supply items - HorseClub</PageTitle>

<h1 class="mb-3">Supply items</h1>

@if (_items.Count == 0)
{
    <div class="alert alert-info">No supply items found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Kind</th>
                    <th>Category</th>
                    <th>Supplier</th>
                    <th>Unit</th>
                    <th>Reorder level</th>
                    <th>Notes</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in _items)
                {
                    <tr @key="item.Id">
                        <td>@item.Code</td>
                        <td>@item.Name</td>
                        <td>@((SupplyKind)item.Kind)</td>
                        <td>@item.Category?.Name</td>
                        <td>@item.Supplier?.Name</td>
                        <td>@item.Unit</td>
                        <td>@item.ReorderLevel.ToString("0.###")</td>
                        <td>@item.Notes</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted small">@_items.Count supply item(s)</p>
}

@code {
    // Read-only list, rendered on the server (no interactivity needed).
    private List<SupplyItem> _items = new();

    protected override async Task OnInitializedAsync()
    {
        _items = await Service.GetAllAsync();
    }
}
