@page "/suppliers"
@inject ISupplierServiceKhoiND Service

<PageTitle>Suppliers - HorseClub</PageTitle>

<h1 class="mb-3">Suppliers</h1>

@if (_items.Count == 0)
{
    <div class="alert alert-info">No suppliers found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>Supply items</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in _items)
                {
                    <tr @key="item.Id">
                        <td>@item.Name</td>
                        <td>@item.Phone</td>
                        <td>@item.Email</td>
                        <td>@item.SupplyItems.Count</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted small">@_items.Count supplier(s)</p>
}

@code {
    // Read-only list, rendered on the server (no interactivity needed).
    private List<Supplier> _items = new();

    protected override async Task OnInitializedAsync()
    {
        _items = await Service.GetAllAsync();
    }
}
