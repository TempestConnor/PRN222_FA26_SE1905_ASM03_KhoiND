@page "/owners"
@inject IOwnerServiceKhoiND Service

<PageTitle>Owners - HorseClub</PageTitle>

<h1 class="mb-3">Owners</h1>

@if (_items.Count == 0)
{
    <div class="alert alert-info">No owners found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Full name</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>Address</th>
                    <th>Horses</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in _items)
                {
                    <tr @key="item.Id">
                        <td>@item.FullName</td>
                        <td>@item.Phone</td>
                        <td>@item.Email</td>
                        <td>@item.Address</td>
                        <td>@item.Horses.Count(h => !h.IsDeleted)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted small">@_items.Count owner(s)</p>
}

@code {
    // Read-only list, rendered on the server (no interactivity needed).
    private List<Owner> _items = new();

    protected override async Task OnInitializedAsync()
    {
        _items = await Service.GetAllAsync();
    }
}
