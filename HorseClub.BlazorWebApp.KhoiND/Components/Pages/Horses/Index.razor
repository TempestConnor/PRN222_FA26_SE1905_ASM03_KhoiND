@page "/"
@page "/horses"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IHorseServiceKhoiND Service
@inject IConfiguration Config
@inject NavigationManager Nav
@inject ILogger<Index> Log

<PageTitle>Horses - HorseClub</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Horses</h1>
    <a href="horses/create" class="btn btn-primary">New horse</a>
</div>

<form class="row g-2 mb-3" @onsubmit="Search" @onsubmit:preventDefault>
    <div class="col-md-3">
        <input class="form-control" placeholder="Name" @bind="_name" />
    </div>
    <div class="col-md-3">
        <input class="form-control" placeholder="Breed" @bind="_breed" />
    </div>
    <div class="col-md-3">
        <input class="form-control" placeholder="Owner name" @bind="_ownerName" />
    </div>
    <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-outline-primary">Search</button>
        <button type="button" class="btn btn-outline-secondary" @onclick="Clear">Clear</button>
    </div>
</form>

@if (_error != null)
{
    <div class="alert alert-danger" role="alert">@_error</div>
}

@if (_horses == null)
{
    <p class="text-muted">Loading...</p>
}
else if (_horses.Count == 0)
{
    <div class="alert alert-info">No horses found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Microchip No</th>
                    <th>Sex</th>
                    <th>Breed</th>
                    <th>Color</th>
                    <th>Birth date</th>
                    <th>Status</th>
                    <th>Owner</th>
                    <th>Sire</th>
                    <th>Dam</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in _horses)
                {
                    <tr @key="item.Id">
                        <td>@item.Name</td>
                        <td>@item.MicrochipNo</td>
                        <td>@((HorseSex)item.Sex)</td>
                        <td>@item.Breed</td>
                        <td>@item.Color</td>
                        <td>@item.BirthDate.ToString("yyyy-MM-dd")</td>
                        <td>@((HorseStatus)item.Status)</td>
                        <td>@item.Owner?.FullName</td>
                        <td>@item.Sire?.Name</td>
                        <td>@item.Dam?.Name</td>
                        <td class="text-nowrap">
                            <a href="horses/details/@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                            <a href="horses/edit/@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            <a href="horses/delete/@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted small">@_horses.Count horse(s)</p>
}

@* Filled when the hub pushes a change or notification. *@
<div class="toast-container position-fixed bottom-0 end-0 p-3">
    @foreach (var toast in _toasts)
    {
        <div @key="toast" class="toast show align-items-center text-bg-dark border-0" role="status">
            <div class="d-flex">
                <div class="toast-body">@toast.Message</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" aria-label="Close"
                        @onclick="() => _toasts.Remove(toast)"></button>
            </div>
        </div>
    }
</div>

@code {
    // GET: /horses?name=..&breed=..&ownerName=..
    [SupplyParameterFromQuery] public string? Name { get; set; }
    [SupplyParameterFromQuery] public string? Breed { get; set; }
    [SupplyParameterFromQuery] public string? OwnerName { get; set; }

    private string? _name, _breed, _ownerName;
    private List<Horse>? _horses;
    private string? _error;
    private HubConnection? _hub;
    private readonly List<Toast> _toasts = new();

    private record Toast(string Message);

    // Runs on first load and whenever the query string changes (Search / Clear).
    protected override async Task OnParametersSetAsync()
    {
        _name = Name;
        _breed = Breed;
        _ownerName = OwnerName;
        await LoadAsync();
    }

    // The hub is opened only once the circuit is interactive, never during prerendering.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var hubUrl = Config["HubUrl"];
        if (string.IsNullOrWhiteSpace(hubUrl)) return;          // standalone mode

        _hub = new HubConnectionBuilder().WithUrl(hubUrl).WithAutomaticReconnect().Build();
        _hub.On<string, HorseDto>(HubContract.ItemChanged, async (action, dto) =>
            await InvokeAsync(() => OnHubMessageAsync($"Horse \"{dto.Name}\" was {action}.")));
        _hub.On<string>(HubContract.Notification, async message =>
            await InvokeAsync(() => OnHubMessageAsync(message)));

        try
        {
            await _hub.StartAsync();
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Hub not reachable at {HubUrl}; live updates are off", hubUrl);
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            _horses = await Service.GetAllAsync(Name, Breed, OwnerName);
            _error = null;
        }
        catch (Exception ex)
        {
            _error = ex.GetBaseException().Message;
            _horses ??= new();
        }
    }

    // Always runs on the renderer's sync context (see InvokeAsync above).
    private async Task OnHubMessageAsync(string message)
    {
        await LoadAsync();
        var toast = new Toast(message);
        _toasts.Add(toast);
        StateHasChanged();

        await Task.Delay(TimeSpan.FromSeconds(4));
        if (_toasts.Remove(toast)) StateHasChanged();
    }

    private void Search() => Navigate(_name, _breed, _ownerName);

    private void Clear() => Navigate(null, null, null);

    private void Navigate(string? name, string? breed, string? ownerName)
    {
        Nav.NavigateTo(Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["name"] = string.IsNullOrWhiteSpace(name) ? null : name,
            ["breed"] = string.IsNullOrWhiteSpace(breed) ? null : breed,
            ["ownerName"] = string.IsNullOrWhiteSpace(ownerName) ? null : ownerName
        }));
    }

    public async ValueTask DisposeAsync()
    {
        if (_hub is not null) await _hub.DisposeAsync();
    }
}
