@* Read-only field list shared by Details and Delete. *@

<dl class="row">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Horse.Name</dd>

    <dt class="col-sm-3">Microchip No</dt>
    <dd class="col-sm-9">@Horse.MicrochipNo</dd>

    <dt class="col-sm-3">Passport No</dt>
    <dd class="col-sm-9">@Horse.PassportNo</dd>

    <dt class="col-sm-3">Sex</dt>
    <dd class="col-sm-9">@((HorseSex)Horse.Sex)</dd>

    <dt class="col-sm-3">Birth date</dt>
    <dd class="col-sm-9">@Horse.BirthDate.ToString("yyyy-MM-dd")</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@((HorseStatus)Horse.Status)</dd>

    <dt class="col-sm-3">Breed</dt>
    <dd class="col-sm-9">@Horse.Breed</dd>

    <dt class="col-sm-3">Color</dt>
    <dd class="col-sm-9">@Horse.Color</dd>

    <dt class="col-sm-3">Owner</dt>
    <dd class="col-sm-9">@Horse.Owner?.FullName</dd>

    <dt class="col-sm-3">Sire</dt>
    <dd class="col-sm-9">@Horse.Sire?.Name</dd>

    <dt class="col-sm-3">Dam</dt>
    <dd class="col-sm-9">@Horse.Dam?.Name</dd>

    <dt class="col-sm-3">Created (UTC)</dt>
    <dd class="col-sm-9">@Horse.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>

    <dt class="col-sm-3">Updated (UTC)</dt>
    <dd class="col-sm-9">@Horse.UpdatedAt?.ToString("yyyy-MM-dd HH:mm")</dd>
</dl>

@code {
    [Parameter, EditorRequired] public Horse Horse { get; set; } = default!;
}
