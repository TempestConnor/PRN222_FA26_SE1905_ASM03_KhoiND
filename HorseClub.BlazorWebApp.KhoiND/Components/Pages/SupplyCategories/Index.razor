@page "/supply-categories"
@inject ISupplyCategoryServiceKhoiND Service

<PageTitle>Supply categories - HorseClub</PageTitle>

<h1 class="mb-3">Supply categories</h1>

@if (_items.Count == 0)
{
    <div class="alert alert-info">No supply categories found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Kind</th>
                    <th>Supply items</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in _items)
                {
                    <tr @key="item.Id">
                        <td>@item.Name</td>
                        <td>@((SupplyKind)item.Kind)</td>
                        <td>@item.SupplyItems.Count</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted small">@_items.Count category(ies)</p>
}

@code {
    // Read-only list, rendered on the server (no interactivity needed).
    private List<SupplyCategory> _items = new();

    protected override async Task OnInitializedAsync()
    {
        _items = await Service.GetAllAsync();
    }
}
